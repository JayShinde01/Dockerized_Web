# frontend/Dockerfile
# Stage 1: Build the Vite React app with build-time envs
FROM node:20-alpine AS build
WORKDIR /app

# Accept build args (Render will pass envs as build args)
ARG VITE_API_BASE_URL
ARG VITE_ML_API_URL

# Export them as env so Vite picks them up during npm run build
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_ML_API_URL=${VITE_ML_API_URL}

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: Serve built files via Nginx
FROM nginx:alpine

# Copy build output
COPY --from=build /app/dist /usr/share/nginx/html

# Copy Nginx config to enable SPA routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
